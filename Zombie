#pragma once
#include "Carta.h"

// ============================================================
//  CLASE: Zombie
//  VID:100  ATK:40  DEF:10  Rareza:Comun
//  Especial: 2 o mas zombies en TU mano -> DEF x2 (una vez)
// ============================================================
class Zombie : public Carta {
public:
    Zombie()
        : Carta("Zombie", 100, 40, 10,
                "Comun",
                "Muerde e infecta a su oponente",
                "2 Zombies en mano -> DEF x2") {}

    void mostrar() const override {
        cout << "  +-----------------------------------------+" << endl;
        cout << "  |  ** ZOMBIE **           [" << rareza << "]" << endl;
        cout << "  |  Nombre  : " << nombre         << endl;
        cout << "  |  Vida    : " << vida
             << " / " << vidaBase                   << endl;
        cout << "  |  Ataque  : " << ataque          << endl;
        cout << "  |  Defensa : " << defensa         << endl;
        cout << "  |  Desc.   : " << descripcion     << endl;
        cout << "  |  Especial: " << ataqueEspecial  << endl;
        if (especialAplicado)
            cout << "  |  [!] DEF ya multiplicada (x2)" << endl;
        cout << "  +-----------------------------------------+" << endl;
    }

    void aplicarEspecial() override {
        if (!especialAplicado) {
            int nuevo = defensa * 2;
            cout << "    [ZOMBIE ESPECIAL] DEF "
                 << defensa << " --> " << nuevo << " (x2)" << endl;
            defensa = nuevo;
            especialAplicado = true;
        }
    }
};
