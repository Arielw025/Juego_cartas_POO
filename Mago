#pragma once
#include "Carta.h"


//  CLASE: Mago
//  VID:300  ATK:100  DEF:50  Rareza:Legendaria
//  Hechizo aleatorio (asignado al repartir):
//    0 = Hechizo Defensa -> DEF x2 (permanente, una vez)
//    1 = Hechizo Ataque  -> ATK x2 (permanente, una vez)
//    2 = Hechizo Robo    -> roba 1 carta ALEATORIA al rival (una vez)

class Mago : public Carta {
private:
    int  tipoHechizo;   // -1 = sin asignar
    bool hechizoUsado;

public:
    Mago()
        : Carta("Mago", 300, 100, 50,
                "Legendaria",
                "Hechizos secretos que ayudan a ganar el juego",
                "Pendiente de asignar"),
          tipoHechizo(-1), hechizoUsado(false) {}

    // Asigna hechizo aleatorio al repartir la carta
    void asignarHechizo() {
        if (tipoHechizo != -1) return;
        tipoHechizo = rand() % 3;
        switch (tipoHechizo) {
            case 0: ataqueEspecial = "Hechizo Defensa: DEF x2 (permanente)";  break;
            case 1: ataqueEspecial = "Hechizo Ataque:  ATK x2 (permanente)";  break;
            case 2: ataqueEspecial = "Hechizo Robo:    roba 1 carta ALAZAR al rival"; break;
        }
    }

    // Solo muestra el hechizo asignado (no lo ejecuta)
    void aplicarEspecial() override {
        if (tipoHechizo == -1) asignarHechizo();
        cout << "    [MAGO] Hechizo asignado: " << ataqueEspecial << endl;
    }

    // Ejecuta el hechizo sobre esta misma carta.
    // Retorna true si es hechizo de robo (el Juego lo gestiona).
    bool usarHechizo() {
        if (hechizoUsado) {
            cout << "    [MAGO] Hechizo ya utilizado anteriormente." << endl;
            return false;
        }
        if (tipoHechizo == -1) asignarHechizo();
        hechizoUsado = true;

        if (tipoHechizo == 0) {
            int nueva = defensa * 2;
            cout << "    [MAGO - HECHIZO DEFENSA] DEF "
                 << defensa << " --> " << nueva << " (x2, permanente)" << endl;
            defensa = nueva;
            especialAplicado = true;
            return false;
        }
        if (tipoHechizo == 1) {
            int nuevo = ataque * 2;
            cout << "    [MAGO - HECHIZO ATAQUE] ATK "
                 << ataque << " --> " << nuevo << " (x2, permanente)" << endl;
            ataque = nuevo;
            especialAplicado = true;
            return false;
        }
        // tipo == 2: robo aleatorio â€” el Juego lo gestiona
        cout << "    [MAGO - HECHIZO ROBO] Roba 1 carta ALAZAR al rival!" << endl;
        return true;
    }

    void mostrar() const override {
        cout << "  +-----------------------------------------+" << endl;
        cout << "  |  ** MAGO **             [" << rareza << "]" << endl;
        cout << "  |  Nombre  : " << nombre         << endl;
        cout << "  |  Vida    : " << vida
             << " / " << vidaBase                   << endl;
        cout << "  |  Ataque  : " << ataque          << endl;
        cout << "  |  Defensa : " << defensa         << endl;
        cout << "  |  Desc.   : " << descripcion     << endl;
        cout << "  |  Hechizo : " << ataqueEspecial  << endl;
        if (hechizoUsado)
            cout << "  |  [!] Hechizo ya utilizado" << endl;
        cout << "  +-----------------------------------------+" << endl;
    }

    int  getTipoHechizo()  const { return tipoHechizo; }
    bool getHechizoUsado() const { return hechizoUsado; }
};
