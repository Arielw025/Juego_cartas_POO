#pragma once
#include "Carta.h"


//  CLASE: Dragon
//  VID:200  ATK:80  DEF:30  Rareza:Rara
//  Especial: 2 o mas dragones en TU mano -> ATK x1.5 (una vez)

class Dragon : public Carta {
public:
    Dragon()
        : Carta("Dragon", 200, 80, 30,
                "Rara",
                "Lanza aliento de fuego",
                "2 Dragones en mano -> ATK x1.5") {}

    void mostrar() const override {
        cout << "  +-----------------------------------------+" << endl;
        cout << "  |  ** DRAGON **           [" << rareza << "]" << endl;
        cout << "  |  Nombre  : " << nombre         << endl;
        cout << "  |  Vida    : " << vida
             << " / " << vidaBase                   << endl;
        cout << "  |  Ataque  : " << ataque          << endl;
        cout << "  |  Defensa : " << defensa         << endl;
        cout << "  |  Desc.   : " << descripcion     << endl;
        cout << "  |  Especial: " << ataqueEspecial  << endl;
        if (especialAplicado)
            cout << "  |  [!] ATK ya multiplicado (x1.5)" << endl;
        cout << "  +-----------------------------------------+" << endl;
    }

    void aplicarEspecial() override {
        if (!especialAplicado) {
            int nuevo = (int)(ataque * 1.5f);
            cout << "    [DRAGON ESPECIAL] ATK "
                 << ataque << " --> " << nuevo << " (x1.5)" << endl;
            ataque = nuevo;
            especialAplicado = true;
        }
    }
};
