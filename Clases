#include <iostream>
#include <string>
#include <vector>
#include <ctime> 
using namespace std;

class Carta {
protected:
    int id;
    string nombre;
    int Mana;
    int vida;
    string tipo;

public:
    Carta(int id, string nombre, int Mana, int vida, string tipo)
        : id(id), nombre(nombre), Mana(Mana), vida(vida), tipo(tipo) {}

    virtual ~Carta() {}

    virtual void jugar() = 0;

    virtual void mostrar() const {
        cout << "Carta: " << nombre << " | Mana: " << Mana << endl;
    }
};

class Trampa : public Carta {
private:
    int danio;
    string tipoDanio;
    bool activa;

public:
    Trampa(int id, string nombre, int Mana, int vida, string tipo,
           int danio, string tipoDanio)
        : Carta(id, nombre, Mana, vida, tipo),
          danio(danio), tipoDanio(tipoDanio), activa(false) {}

    void activar() { activa = true; }

    void aplicarEfecto() {
        if (activa)
            cout << "Trampa activa: daño " << danio << endl;
    }

    void jugar() override {
        activar();
        cout << "Trampa activada: " << nombre << endl;
    }
};

class Hechizo : public Carta {
protected:
    int duracion;
    string tipoEfecto;
    int intensidad;

public:
    Hechizo(int id, string nombre, int Mana, int vida, string tipo,
            int duracion, string tipoEfecto, int intensidad)
        : Carta(id, nombre, Mana, vida, tipo),
          duracion(duracion), tipoEfecto(tipoEfecto), intensidad(intensidad) {}

    void aplicarEfecto() {
        cout << "Hechizo: " << tipoEfecto
             << " Intensidad: " << intensidad
             << " Duracion: " << duracion << endl;
    }

    void jugar() override {
        cout << "Usando hechizo: " << nombre << endl;
        aplicarEfecto();
    }
};

class Monstruo : public Carta {
protected:
    int ataque;
    int defensa;
    string tipoElemento;

public:
    Monstruo(int id, string nombre, int Mana, int vida, string tipo,
             int ataque, int defensa, string elemento)
        : Carta(id, nombre, Mana, vida, tipo),
          ataque(ataque), defensa(defensa), tipoElemento(elemento) {}

    virtual void atacar() = 0;

    void recibirDanio(int dmg) {
        vida -= dmg;
        if (vida < 0) vida = 0;
    }
};

class Dragon : public Monstruo {
public:
    Dragon(int id, string nombre)
        : Monstruo(id, nombre, 10, 100, "Dragon", 50, 30, "Fuego") {}

    void atacar() override {
        cout << "Dragon ataca con fuego\n";
    }

    void jugar() override {
        cout << nombre << " entra al campo\n";
    }
};

class Arquero : public Monstruo {
private:
    int precision;

public:
    Arquero(int id, string nombre)
        : Monstruo(id, nombre, 4, 70, "Arquero", 25, 15, "Viento"),
          precision(80) {}

    void atacar() override {
        cout << "Arquero dispara una flecha precisa\n";
    }

    void jugar() override {
        cout << nombre << " entra al campo\n";
    }
};

class Mago : public Monstruo {
private:
    int manaInterno;
    vector<Hechizo*> hechizos;
    vector<Trampa*> trampas;

public:
    Mago(int id, string nombre)
        : Monstruo(id, nombre, 5, 80, "Mago", 15, 10, "Luz"),
          manaInterno(100) {}

    void atacar() override {
        cout << "Mago lanza un ataque mágico\n";
    }

    void jugar() override {
        cout << nombre << " entra al campo\n";
    }
};

class Baraja {
private:
    vector<Carta*> cartas;

public:
    void agregarCarta(Carta* c) {
        cartas.push_back(c);
    }

    void mostrarBaraja() {
        cout << "\n Baraja \n";
        for (auto c : cartas) {
            c->mostrar();
        }
    }

    Carta* robarCarta() {
        if (cartas.empty()) {
            cout << "No hay cartas\n";
            return nullptr;
        }

        Carta* c = cartas.back();
        cartas.pop_back();
        return c;
    }

    bool estaVacia() {
        return cartas.empty();
    }
};

Carta* crearCartaAleatoria(int id) {
    int tipo = rand() % 5;

    switch (tipo) {
        case 0:
            return new Dragon(id, "Dragon " + to_string(id));

        case 1:
            return new Arquero(id, "Arquero " + to_string(id));

        case 2:
            return new Mago(id, "Mago " + to_string(id));

        case 3:
            return new Hechizo(
                id,
                "Hechizo " + to_string(id),
                rand() % 5 + 1,
                0,
                "Hechizo",
                rand() % 3 + 1,
                "Efecto aleatorio",
                rand() % 30 + 10
            );

        case 4:
            return new Trampa(
                id,
                "Trampa " + to_string(id),
                rand() % 5 + 1,
                0,
                "Trampa",
                rand() % 25 + 5,
                "Daño sorpresa"
            );
    }

    return nullptr;
}

int main() {
    srand(time(0));

    Baraja baraja;

    int cantidadCartas = 10;

    // Baraja aleatoria
    for (int i = 0; i < cantidadCartas; i++) {
        Carta* c = crearCartaAleatoria(i + 1);
        baraja.agregarCarta(c);
    }

    // Mostrar baraja
    baraja.mostrarBaraja();

    cout << "\nRobando cartas...\n";

    while (!baraja.estaVacia()) {
        Carta* carta = baraja.robarCarta();
        if (carta) {
            carta->mostrar();
            carta->jugar();
        }
    }

    return 0;
}

