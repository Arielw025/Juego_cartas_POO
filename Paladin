#pragma once
#include "Carta.h"

// ============================================================
//  CLASE: Paladin
//  VID:150  ATK:60  DEF:20  Rareza:Comun
//  Especial: 2 o mas paladines en TU mano -> VID x2 (una vez)
// ============================================================
class Paladin : public Carta {
public:
    Paladin()
        : Carta("Paladin", 150, 60, 20,
                "Comun",
                "Caballero con un golpe sagrado",
                "2 Paladines en mano -> VID x2") {}

    void mostrar() const override {
        cout << "  +-----------------------------------------+" << endl;
        cout << "  |  ** PALADIN **          [" << rareza << "]" << endl;
        cout << "  |  Nombre  : " << nombre         << endl;
        cout << "  |  Vida    : " << vida
             << " / " << vidaBase                   << endl;
        cout << "  |  Ataque  : " << ataque          << endl;
        cout << "  |  Defensa : " << defensa         << endl;
        cout << "  |  Desc.   : " << descripcion     << endl;
        cout << "  |  Especial: " << ataqueEspecial  << endl;
        if (especialAplicado)
            cout << "  |  [!] VID ya multiplicada (x2)" << endl;
        cout << "  +-----------------------------------------+" << endl;
    }

    void aplicarEspecial() override {
        if (!especialAplicado) {
            int nuevo = vida * 2;
            cout << "    [PALADIN ESPECIAL] VID "
                 << vida << " --> " << nuevo << " (x2)" << endl;
            vida    = nuevo;
            vidaBase = nuevo;   // actualizar base tambien
            especialAplicado = true;
        }
    }
};
