#pragma once
#include <string>
#include <iostream>
#include <cstdlib>
using namespace std;


//CLASE ABSTRACTA:Carta

class Carta {
protected:
    string nombre;
    int    vidaBase;        
    int    vida;            
    int    ataque;
    int    defensa;
    string rareza;
    string descripcion;
    string ataqueEspecial;
    bool   especialAplicado;

public:
    Carta(const string& nom, int v, int a, int d,
          const string& rar, const string& desc,
          const string& especial)
        : nombre(nom), vidaBase(v), vida(v), ataque(a), defensa(d),
          rareza(rar), descripcion(desc),
          ataqueEspecial(especial), especialAplicado(false) {}

    virtual ~Carta() {}

    virtual void mostrar() const   = 0;
    virtual void aplicarEspecial() = 0;


    //defensa se lanzan 2 dados si true=suma par =defensa aplica
    bool lanzarDados() const {
        int d1   = (rand() % 6) + 1;
        int d2   = (rand() % 6) + 1;
        int suma = d1 + d2;
        cout << "    Dado 1: " << d1
             << "  |  Dado 2: " << d2
             << "  |  Suma: "   << suma;
        if (suma % 2 == 0) {
            cout << " (PAR)   --> Defensa aplicada!" << endl;
            return true;
        }
        cout << " (IMPAR) --> Defensa NO aplicada." << endl;
        return false;
    }

  
    bool recibirDanio(int danioAtaque) {
        bool defActiva = lanzarDados();
        int danioFinal = danioAtaque;
        if (defActiva) {
            danioFinal = max(0, danioAtaque - defensa);
            cout << "    Danio neto  : " << danioFinal
                 << " (" << danioAtaque << " ATK - "
                 << defensa << " DEF)" << endl;
        } else {
            cout << "    Danio total : " << danioFinal
                 << " (sin defensa)" << endl;
        }
        vida -= danioFinal;
        if (vida < 0) vida = 0;   // no pasa de 0, no afecta otras cartas
        cout << "    " << nombre << " queda con VID: " << vida << endl;
        return vida <= 0;
    }

    
    string getNombre()         const { return nombre; }
    int    getVida()           const { return vida; }
    int    getVidaBase()       const { return vidaBase; }
    int    getAtaque()         const { return ataque; }
    int    getDefensa()        const { return defensa; }
    string getRareza()         const { return rareza; }
    string getDescripcion()    const { return descripcion; }
    string getAtaqueEspecial() const { return ataqueEspecial; }
    bool   getEspecialAplic()  const { return especialAplicado; }

    // Setters
    void setVida(int v)           { vida = v; }
    void setAtaque(int a)         { ataque = a; }
    void setDefensa(int d)        { defensa = d; }
    void setEspecialAplic(bool e) { especialAplicado = e; }
    void setAtaqueEspecial(const string& s) { ataqueEspecial = s; }
};
