#pragma once
#include "Juego.h"
#include <iostream>
#include <limits>
using namespace std;

// ============================================================
//  CLASE: Menu
// ============================================================
class Menu {
private:
    void linea(char c = '=', int n = 52) {
        cout << "\n";
        for (int i = 0; i < n; i++) cout << c;
        cout << "\n";
    }

    int leerInt(const string& msg, int minVal, int maxVal) {
        int val;
        while (true) {
            cout << msg;
            if (cin >> val && val >= minVal && val <= maxVal) {
                cin.ignore(numeric_limits<streamsize>::max(), '\n');
                return val;
            }
            cin.clear();
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
            cout << "  Valor invalido. Ingrese entre "
                 << minVal << " y " << maxVal << ".\n";
        }
    }

    string leerNombre(const string& msg) {
        string nombre;
        if (cin.peek() == '\n') cin.ignore();
        cout << msg;
        getline(cin, nombre);
        while (nombre.empty()) {
            cout << "  El nombre no puede estar vacio.\n" << msg;
            getline(cin, nombre);
        }
        return nombre;
    }

public:
    void mostrar() {
        int op = -1;
        while (op != 0) {
            linea();
            cout << "    SIMULADOR DE JUEGO DE CARTAS\n";
            cout << "    Barbara Perez / Ariel Martinez\n";
            linea();
            cout << "  1. Nueva partida\n";
            cout << "  2. Ver reglas\n";
            cout << "  0. Salir\n";
            op = leerInt("  >> ", 0, 2);
            if (op == 1) menuNuevaPartida();
            if (op == 2) mostrarReglas();
        }
        cout << "\n  Hasta pronto!\n\n";
    }

    void menuNuevaPartida() {
        linea();
        cout << "  NUEVA PARTIDA\n";
        linea('-', 40);

        string nom1 = leerNombre("  Nombre Jugador 1: ");
        string nom2 = leerNombre("  Nombre Jugador 2: ");

        linea('-', 40);
        cout << "  El mazo tiene 30 cartas (max 15 por jugador).\n";
        int cant = leerInt("  Cantidad de cartas por jugador [1-15]: ", 1, 15);

        linea('-', 40);
        cout << "  Jugador 1 : " << nom1 << "\n";
        cout << "  Jugador 2 : " << nom2 << "\n";
        cout << "  Cartas c/u: " << cant << "\n";
        linea('-', 40);
        cout << "  1. Comenzar   0. Cancelar\n";
        int conf = leerInt("  >> ", 0, 1);
        if (conf == 0) return;

        Jugador* pj1  = new Jugador(nom1);
        Jugador* pj2  = new Jugador(nom2);
        Mazo*    mazo = new Mazo();

        Juego juego(pj1, pj2, mazo, cant);
        juego.iniciar();

        delete pj1;
        delete pj2;
        delete mazo;
    }

    void mostrarReglas() {
        linea();
        cout <<
            "  REGLAS DEL JUEGO\n\n"
            "  MAZO: 30 cartas\n"
            "    4  Magos     [Legendaria]  VID:300 ATK:100 DEF:50\n"
            "    6  Dragones  [Rara]        VID:200 ATK:80  DEF:30\n"
            "   10  Zombies   [Comun]       VID:100 ATK:40  DEF:10\n"
            "   10  Paladines [Comun]       VID:150 ATK:60  DEF:20\n\n"
            "  ATAQUES ESPECIALES (solo afectan al jugador que los tiene):\n"
            "    Dragon : 2+ en tu mano -> tu ATK x1.5 (una vez)\n"
            "    Zombie : 2+ en tu mano -> tu DEF x2   (una vez)\n"
            "    Paladin: 2+ en tu mano -> tu VID x2   (una vez)\n"
            "    Mago   : hechizo aleatorio al repartirse:\n"
            "      Hechizo Defensa -> DEF x2 (permanente)\n"
            "      Hechizo Ataque  -> ATK x2 (permanente)\n"
            "      Hechizo Robo    -> roba 1 carta ALAZAR al rival\n\n"
            "  DEFENSA (dados):\n"
            "    2 dados. Suma PAR = defensa aplica.\n"
            "    Suma IMPAR = defensa NO aplica.\n"
            "    Si el ATK supera la VID de la carta, esa carta muere.\n"
            "    El danio NO se transfiere a otras cartas.\n\n"
            "  FLUJO (5 turnos por ronda):\n"
            "    Turno 1:\n"
            "      J1 elige carta A | J2 elige carta B\n"
            "      J1 ataca B con A (dados de J2)\n"
            "      J2 ataca A con B (dados de J1)\n"
            "    Turno 2-5:\n"
            "      J1 ve carta anterior (A) con vida actualizada,\n"
            "         elige nueva carta A'\n"
            "      J1 ataca B (anterior) con A' (dados de J2)\n"
            "      J2 ve carta anterior (B) con vida actualizada,\n"
            "         elige nueva carta B'\n"
            "      J2 ataca A' con B' (dados de J1)\n"
            "    Al fin: se eliminan cartas con vida <= 0.\n"
            "    Siguiente ronda: el otro jugador empieza.\n\n"
            "  VICTORIA: quien deje al rival sin cartas gana.\n"
            "  Escribe 0 en cualquier momento para salir.\n";
        linea('-', 40);
        cout << "  [Presione ENTER para volver...]\n";
        cin.ignore(numeric_limits<streamsize>::max(), '\n');
        cin.get();
    }
};
