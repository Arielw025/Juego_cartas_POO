#pragma once
#include "Jugador.h"
#include "Mazo.h"
#include <vector>
#include <limits>
using namespace std;

// ============================================================
//  CLASE: Juego
//  Lógica de rondas, turnos y combate
// ============================================================
class Juego {
private:
    Jugador* j1;
    Jugador* j2;
    Mazo*    mazo;
    int      cantCartas;    
    int      rondaGlobal;   
    vector<Carta*> cartasUsadas; // cartas usadas, para liberar memoria

    void pausar() {
        cout << "\n  [Presione ENTER para continuar...]";
        cin.ignore(numeric_limits<streamsize>::max(), '\n');
        cin.get();
    }

    int leerInt(const string& msg, int min, int max) {
        int val;
        while (true) {
            cout << msg;
            if (cin >> val && val >= min && val <= max) {
                cin.ignore(numeric_limits<streamsize>::max(), '\n');
                return val;
            }
            cin.clear();
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
            cout << "  Entrada invalida. Ingrese un numero entre "
                 << min << " y " << max << "." << endl;
        }
    }

    void separador(char c = '=', int n = 50) {
        cout << "\n";
        for (int i = 0; i < n; i++) cout << c;
        cout << "\n";
    }


    void repartirCartas() {
      
        for (int i = 0; i < cantCartas; i++) {
            Carta* c1 = mazo->robar();
            Carta* c2 = mazo->robar();
            if (c1) j1->recibirCarta(c1);
            if (c2) j2->recibirCarta(c2);
        }
        cout << "\n  Cartas repartidas: " << cantCartas
             << " a cada jugador." << endl;
    }

    void mostrarManoJugador(Jugador* j) {
        separador('-');
        cout << "  Turno de ver cartas: " << j->getNombre() << endl;
        separador('-');
        j->mostrarMano();
    }


    void aplicarEspeciales(Jugador* j) {
        separador('-', 40);
        cout << "  [ESPECIALES] Verificando cartas de "
             << j->getNombre() << "..." << endl;
        j->verificarEspeciales();
    }


    void ejecutarHechizoRobo(Jugador* dueno, Jugador* rival) {
        cout << "\n  [HECHIZO ROBO] " << dueno->getNombre()
             << " roba una carta aleatoria a "
             << rival->getNombre() << "!" << endl;

        Carta* robada = rival->perderCartaAleatoria();
        if (robada) {
            cout << "  Carta robada: " << robada->getNombre()
                 << " (" << robada->getRareza() << ")" << endl;
            dueno->recibirCarta(robada);
        } else {
            cout << "  " << rival->getNombre()
                 << " no tiene cartas para robar." << endl;
        }
    }


    // primerJugador empieza eligiendo; segundoJugador responde
    bool jugarRonda(Jugador* primero, Jugador* segundo) {
        separador();
        cout << "  RONDA — " << primero->getNombre()
             << " ataca primero" << endl;
        separador();

        int turnosRonda = min(5, min(primero->getCantidad(),
                                     segundo->getCantidad()));
        if (turnosRonda == 0) return false;

        for (int turno = 1; turno <= turnosRonda; turno++) {
            separador('-', 40);
            cout << "  --- Turno " << turno << " de " << turnosRonda
                 << " ---" << endl;

        //1er elegir carta
            cout << "\n  [" << primero->getNombre()
                 << "] Elige tu carta de ataque:" << endl;
            primero->mostrarMano();
            int idx1 = leerInt("  >> Numero de carta (1-" +
                               to_string(primero->getCantidad()) + "): ",
                               1, primero->getCantidad());
            Carta* cartaPrimero = primero->elegirCarta(idx1);

        
            Mago* magoPrimero = dynamic_cast<Mago*>(cartaPrimero);
            if (magoPrimero && !magoPrimero->getHechizoUsado()) {
                bool esRobo = false;
                magoPrimero->usarHechizo(esRobo);
                if (esRobo) ejecutarHechizoRobo(primero, segundo);
            }

            //2do elige carta
            cout << "\n  [" << segundo->getNombre()
                 << "] Elige tu carta de ataque:" << endl;
            segundo->mostrarMano();
            int idx2 = leerInt("  >> Numero de carta (1-" +
                               to_string(segundo->getCantidad()) + "): ",
                               1, segundo->getCantidad());
            Carta* cartaSegundo = segundo->elegirCarta(idx2);


            Mago* magoSegundo = dynamic_cast<Mago*>(cartaSegundo);
            if (magoSegundo && !magoSegundo->getHechizoUsado()) {
                bool esRobo = false;
                magoSegundo->usarHechizo(esRobo);
                if (esRobo) ejecutarHechizoRobo(segundo, primero);
            }

            separador('-', 40);
            cout << "  COMBATE del turno " << turno << ":" << endl;
            cout << "  " << primero->getNombre()
                 << " usa: " << cartaPrimero->getNombre() << endl;
            cout << "  " << segundo->getNombre()
                 << " usa: " << cartaSegundo->getNombre() << endl;

            //1er ataca a 2do
            cout << "\n  >> " << primero->getNombre()
                 << " ataca con " << cartaPrimero->getNombre()
                 << " (ATK: " << cartaPrimero->getAtaque() << ")"
                 << " a " << cartaSegundo->getNombre()
                 << " (DEF: " << cartaSegundo->getDefensa() << ")" << endl;

            cout << "  Lanzando dados para defensa de "
                 << segundo->getNombre() << "..." << endl;
            bool defSegundo = cartaSegundo->lanzarDados();

            int danio1 = cartaPrimero->getAtaque();
            if (defSegundo) {
                danio1 = max(0, danio1 - cartaSegundo->getDefensa());
                cout << "  Danio neto (ataque - defensa): " << danio1 << endl;
            } else {
                cout << "  Danio total (sin defensa): " << danio1 << endl;
            }
            int vidaRestante2 = cartaSegundo->getVida() - danio1;
            cartaSegundo->setVida(vidaRestante2);
            segundo->recibirDanioTotal(danio1);
            cout << "  " << cartaSegundo->getNombre()
                 << " queda con vida: " << vidaRestante2 << endl;

            // 2do ataca 1er
            cout << "\n  >> " << segundo->getNombre()
                 << " ataca con " << cartaSegundo->getNombre()
                 << " (ATK: " << cartaSegundo->getAtaque() << ")"
                 << " a " << cartaPrimero->getNombre()
                 << " (DEF: " << cartaPrimero->getDefensa() << ")" << endl;

            cout << "  Lanzando dados para defensa de "
                 << primero->getNombre() << "..." << endl;
            bool defPrimero = cartaPrimero->lanzarDados();

            int danio2 = cartaSegundo->getAtaque();
            if (defPrimero) {
                danio2 = max(0, danio2 - cartaPrimero->getDefensa());
                cout << "  Danio neto (ataque - defensa): " << danio2 << endl;
            } else {
                cout << "  Danio total (sin defensa): " << danio2 << endl;
            }
            int vidaRestante1 = cartaPrimero->getVida() - danio2;
            cartaPrimero->setVida(vidaRestante1);
            primero->recibirDanioTotal(danio2);
            cout << "  " << cartaPrimero->getNombre()
                 << " queda con vida: " << vidaRestante1 << endl;

            // Guardar cartas usadas para liberar memoria al final
            cartasUsadas.push_back(cartaPrimero);
            cartasUsadas.push_back(cartaSegundo);

            pausar();

            // Verificar si alguien se quedo sin cartas en mano
            if (primero->sinCartas() || segundo->sinCartas()) break;
        }

        return true;
    }


    void mostrarResumen() {
        separador();
        cout << "  ESTADO ACTUAL" << endl;
        cout << "  " << j1->getNombre() << ": "
             << j1->getCantidad() << " cartas | Vida total: "
             << j1->calcularVidaTotal() << endl;
        cout << "  " << j2->getNombre() << ": "
             << j2->getCantidad() << " cartas | Vida total: "
             << j2->calcularVidaTotal() << endl;
    }

public:
    Juego(Jugador* j1, Jugador* j2, Mazo* mazo, int cantCartas)
        : j1(j1), j2(j2), mazo(mazo),
          cantCartas(cantCartas), rondaGlobal(1) {}

    ~Juego() {
        for (Carta* c : cartasUsadas) delete c;
    }

// Flujo de partida principal..
    void iniciar() {
        separador();
        cout << "  INICIO DE PARTIDA" << endl;
        cout << "  " << j1->getNombre() << "  VS  " << j2->getNombre() << endl;
        cout << "  Cartas por jugador: " << cantCartas << endl;
        separador();

        mazo->barajar();

        Jugador* primerTurno  = j1;
        Jugador* segundoTurno = j2;

        while (true) {

            separador();
            cout << "  Repartiendo " << cantCartas
                 << " cartas a cada jugador..." << endl;
            repartirCartas();

            if (mazo->estaVacio() && j1->sinCartas() && j2->sinCartas()) {
                cout << "\n  El mazo se agoto. Fin de la partida." << endl;
                break;
            }

       
            pausar();
            mostrarManoJugador(j1);
            aplicarEspeciales(j1);
            pausar();

    
            mostrarManoJugador(j2);
            aplicarEspeciales(j2);
            pausar();

    
            jugarRonda(primerTurno, segundoTurno);
            mostrarResumen();

          //condicion para terminar/ganar prtida 
            if (j1->sinCartas() && j2->sinCartas()) {
                // Ambos sin cartas — gana quien tenga menos danio recibido
                // Quien se quede sin cartas primero 
                break;
            }
            if (j1->sinCartas()) {
                declararGanador(j2);
                return;
            }
            if (j2->sinCartas()) {
                declararGanador(j1);
                return;
            }

            // Rebarajar (para más de 1 ronda, 5 cartas) 
            separador('-', 40);
            cout << "  Fin de ronda. Devolviendo cartas al mazo..." << endl;
            vector<Carta*> dev1 = j1->devolverCartas();
            vector<Carta*> dev2 = j2->devolverCartas();
            // Cartas usadas enviadas a cartasUsada
            mazo->construir();
            mazo->barajar();
            // Las cartas devueltas liberan memoria  
            for (Carta* c : dev1) cartasUsadas.push_back(c);
            for (Carta* c : dev2) cartasUsadas.push_back(c);

            // Intercambiar quien empieza
            swap(primerTurno, segundoTurno);
            rondaGlobal++;
            pausar();
        }

        // Determinar ganador por danio total
            int danio1 = j1->getDanioRecibido();
            int danio2 = j2->getDanioRecibido();

            if (danio1 < danio2) {
                declararGanador(j1);
            }
                else if (danio2 < danio1) {
                declararGanador(j2);
            }
                else {
                    separador();
                    cout << "  EMPATE! Ambos jugadores recibieron el mismo daño." << endl;
            }

    void declararGanador(Jugador* ganador) {
        separador('*');
        cout << "  GANADOR: " << ganador->getNombre() << "!" << endl;
        cout << "  Cartas restantes: " << ganador->getCantidad() << endl;
        cout << "  Vida total restante: " << ganador->calcularVidaTotal() << endl;
        separador('*');
    }
};
