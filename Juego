#pragma once
#include "Jugador.h"
#include "Mazo.h"
#include <limits>
#include <iostream>
using namespace std;


//  CLASE: Juego
//
//  FLUJO DE RONDA (5 turnos):
//
//  Antes de los turnos: ver cartas + especiales de cada jugador
//
//  Turno 1:
//    J_A elige carta (idxA) â€” queda en su mano
//    J_B elige carta (idxB) â€” queda en su mano
//    J_A ataca con cartaA a cartaB --> dados de J_B
//    J_B ataca con cartaB a cartaA --> dados de J_A
//
//  Turno 2-5:
//    J_A retira cartaA del turno anterior, ve mano, elige nueva cartaA
//    J_A ataca cartaB anterior con nueva cartaA --> dados de J_B
//    J_B retira cartaB del turno anterior, ve mano, elige nueva cartaB
//    J_B ataca cartaA (nueva) con nueva cartaB --> dados de J_A
//
//  Fin de ronda: eliminar cartas con vida <= 0
//  Siguiente ronda: J_B empieza. Cartas con vida actualizada se conservan.

class Juego {
private:
    Jugador* j1;
    Jugador* j2;
    Mazo*    mazo;
    int      cantCartas;
    bool     salirFlag;


    int leerOpcion(const string& msg, int minVal, int maxVal) {
        int val;
        while (true) {
            cout << msg;
            if (!(cin >> val)) {
                cin.clear();
                cin.ignore(numeric_limits<streamsize>::max(), '\n');
                cout << "  Entrada invalida." << endl;
                continue;
            }
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
            if (val == 0) { salirFlag = true; return -1; }
            if (val >= minVal && val <= maxVal) return val;
            cout << "  Fuera de rango [" << minVal
                 << "-" << maxVal << "] o 0 para salir." << endl;
        }
    }

    void pausar() {
        cout << "\n  [Presione ENTER para continuar...]";
        cin.ignore(numeric_limits<streamsize>::max(), '\n');
        cin.get();
    }

    void linea(char c = '=', int n = 52) {
        cout << "\n";
        for (int i = 0; i < n; i++) cout << c;
        cout << "\n";
    }

    void repartir() {
        for (int i = 0; i < cantCartas; i++) {
            Carta* c1 = mazo->robar();
            Carta* c2 = mazo->robar();
            if (c1) j1->recibirCarta(c1);
            if (c2) j2->recibirCarta(c2);
        }
        cout << "  Cartas repartidas: "
             << cantCartas << " a cada jugador." << endl;
    }

    // â”€â”€ Hechizo Robo: ladron roba 1 carta alazar a victima â”€
    void ejecutarRobo(Jugador* ladron, Jugador* victima) {
        Carta* robada = victima->perderCartaAleatoria();
        if (robada) {
            cout << "  [ROBO ALAZAR] " << ladron->getNombre()
                 << " robo la carta '"
                 << robada->getNombre() << "' de "
                 << victima->getNombre() << "!" << endl;
            // Actualizar hechizo si la carta robada es Mago
            Mago* m = dynamic_cast<Mago*>(robada);
            if (m) m->asignarHechizo();
            ladron->recibirCarta(robada);
        } else {
            cout << "  [ROBO] " << victima->getNombre()
                 << " no tenia cartas para robar." << endl;
        }
    }


    int elegirCarta(Jugador* j, const string& accion) {
        if (j->getCantidad() == 0) return -1;
        cout << "\n  " << j->getNombre() << " â€” " << accion << endl;
        j->mostrarManoResumida();
        cout << "  (0 para salir de la partida)" << endl;
        int op = leerOpcion("  >> Elige carta [1-"
                            + to_string(j->getCantidad()) + "]: ",
                            1, j->getCantidad());
        if (salirFlag) return -1;
        return op - 1;
    }


    void mostrarCartasJugador(Jugador* j) {
        linea('-', 40);
        cout << "  Estas son tus cartas, "
             << j->getNombre() << ":" << endl;
        j->mostrarMano();
    }

    // â”€â”€ Mostrar especiales SOLO del jugador indicado â”€â”€â”€â”€â”€â”€â”€
    void mostrarEspeciales(Jugador* j) {
        linea('-', 40);
        cout << "  [ESPECIALES] " << j->getNombre() << ":" << endl;
        j->verificarEspeciales();
    }

    
    void resolverCombate(Jugador* atacante, Carta* cartaAtac,
                         Jugador* defensor, Carta* cartaDef) {
        linea('-', 40);
        cout << "  >> " << atacante->getNombre()
             << " ataca con: " << cartaAtac->getNombre()
             << "  (ATK: " << cartaAtac->getAtaque() << ")" << endl;
        cout << "     Objetivo : " << cartaDef->getNombre()
             << "  (DEF: " << cartaDef->getDefensa()
             << "  VID: "  << cartaDef->getVida() << ")" << endl;
        cout << "\n  Lanzando dados para la defensa de "
             << defensor->getNombre() << "..." << endl;

        bool muerta = cartaDef->recibirDanio(cartaAtac->getAtaque());
        if (muerta)
            cout << "    [!] " << cartaDef->getNombre()
                 << " fue derrotada!" << endl;
    }

    
    void mostrarEstadoRapido() {
        linea('-', 40);
        cout << "  Estado actual:" << endl;
        cout << "  " << j1->getNombre()
             << " (" << j1->getCantidad() << " cartas):" << endl;
        j1->mostrarManoResumida();
        cout << "  " << j2->getNombre()
             << " (" << j2->getCantidad() << " cartas):" << endl;
        j2->mostrarManoResumida();
    }

   
    bool jugarRonda(Jugador* primero, Jugador* segundo) {
        linea();
        cout << "  NUEVA RONDA"
             << " â€” " << primero->getNombre()
             << " comienza atacando" << endl;
        linea();

        mostrarCartasJugador(primero);
        mostrarEspeciales(primero);
        pausar();

        // Jugador segundo ve SUS cartas y SUS especiales
        mostrarCartasJugador(segundo);
        mostrarEspeciales(segundo);
        pausar();

        int idxPrimero = -1;
        int idxSegundo = -1;

        for (int turno = 1; turno <= 5; turno++) {
            if (primero->sinCartas() || segundo->sinCartas()) break;

            linea();
            cout << "  TURNO " << turno << " de 5" << endl;

          
            if (turno == 1) {

                idxPrimero = elegirCarta(primero, "Elige tu carta de ataque:");
                if (salirFlag) return false;
            } else {
                
                Carta* ant = primero->verCarta(idxPrimero);
                if (ant) {
                    cout << "\n  " << primero->getNombre()
                         << " â€” tu carta anterior:" << endl;
                    cout << "  Carta [" << idxPrimero+1 << "]:" << endl;
                    ant->mostrar();
                }
                idxPrimero = elegirCarta(primero,
                    "Elige tu nueva carta de ataque:");
                if (salirFlag) return false;
            }
            Carta* cartaPrimero = primero->verCarta(idxPrimero);

            
            Mago* magP = dynamic_cast<Mago*>(cartaPrimero);
            if (magP && !magP->getHechizoUsado()) {
                linea('-', 40);
                cout << "  [MAGO] " << primero->getNombre()
                     << " tiene un hechizo disponible:" << endl;
                cout << "    " << cartaPrimero->getAtaqueEspecial() << endl;
                cout << "  1. Usar hechizo   2. Guardar para despues"
                     << "  (0=salir)" << endl;
                int op = leerOpcion("  >> ", 1, 2);
                if (salirFlag) return false;
                if (op == 1) {
                    bool esRobo = magP->usarHechizo();
                    if (esRobo) ejecutarRobo(primero, segundo);
                    // Actualizar vista del mago
                    cout << "  Carta actualizada:" << endl;
                    cartaPrimero->mostrar();
                }
            }

            
            if (turno == 1) {
                idxSegundo = elegirCarta(segundo, "Elige tu carta de ataque:");
                if (salirFlag) return false;
            } else {
                Carta* ant = segundo->verCarta(idxSegundo);
                if (ant) {
                    cout << "\n  " << segundo->getNombre()
                         << " â€” tu carta anterior:" << endl;
                    cout << "  Carta [" << idxSegundo+1 << "]:" << endl;
                    ant->mostrar();
                }
                idxSegundo = elegirCarta(segundo,
                    "Elige tu nueva carta de ataque:");
                if (salirFlag) return false;
            }
            Carta* cartaSegundo = segundo->verCarta(idxSegundo);

            
            Mago* magS = dynamic_cast<Mago*>(cartaSegundo);
            if (magS && !magS->getHechizoUsado()) {
                linea('-', 40);
                cout << "  [MAGO] " << segundo->getNombre()
                     << " tiene un hechizo disponible:" << endl;
                cout << "    " << cartaSegundo->getAtaqueEspecial() << endl;
                cout << "  1. Usar hechizo   2. Guardar para despues"
                     << "  (0=salir)" << endl;
                int op = leerOpcion("  >> ", 1, 2);
                if (salirFlag) return false;
                if (op == 1) {
                    bool esRobo = magS->usarHechizo();
                    if (esRobo) ejecutarRobo(segundo, primero);
                    cout << "  Carta actualizada:" << endl;
                    cartaSegundo->mostrar();
                }
            }

           
            linea('-', 40);
            cout << "  COMBATE â€” Turno " << turno << endl;

            // Primero ataca a la carta del Segundo
            resolverCombate(primero, cartaPrimero,
                            segundo, cartaSegundo);

            // Segundo ataca a la carta del Primero
            resolverCombate(segundo, cartaSegundo,
                            primero, cartaPrimero);

            mostrarEstadoRapido();

         linea('-', 40);
            cout << "  Escribe 0 para salir o ENTER para continuar: ";
            string ent;
            getline(cin, ent);
            if (ent == "0") { salirFlag = true; return false; }
        }

 
        linea();
        cout << "  FIN DE RONDA â€” Cartas eliminadas:" << endl;
        int e1 = primero->eliminarMuertas();
        int e2 = segundo->eliminarMuertas();
        if (e1 + e2 == 0)
            cout << "    (Ninguna carta fue eliminada esta ronda)" << endl;

        return true;
    }

public:
    Juego(Jugador* j1, Jugador* j2, Mazo* mazo, int cant)
        : j1(j1), j2(j2), mazo(mazo),
          cantCartas(cant), salirFlag(false) {}

    void iniciar() {
        linea('*');
        cout << "  INICIO DE PARTIDA" << endl;
        cout << "  " << j1->getNombre()
             << "  VS  " << j2->getNombre() << endl;
        cout << "  Cartas por jugador: " << cantCartas << endl;
        linea('*');

        mazo->barajar();
        repartir();

        Jugador* primero = j1;
        Jugador* segundo = j2;

        while (!j1->sinCartas() && !j2->sinCartas()) {
            bool continua = jugarRonda(primero, segundo);

            if (!continua) {
                linea();
                cout << "  Partida abandonada." << endl;
                return;
            }

            if (j1->sinCartas() || j2->sinCartas()) break;

            // Intercambiar quien empieza la siguiente ronda
            swap(primero, segundo);
            linea('-', 40);
            cout << "  La siguiente ronda la inicia: "
                 << primero->getNombre() << endl;
            pausar();
        }

        declararGanador();
    }

    void declararGanador() {
        linea('*');
        if (!j1->sinCartas() && j2->sinCartas()) {
            cout << "  GANADOR: " << j1->getNombre() << "!" << endl;
            cout << "  Le quedan "
                 << j1->getCantidad() << " carta(s)." << endl;
        } else if (!j2->sinCartas() && j1->sinCartas()) {
            cout << "  GANADOR: " << j2->getNombre() << "!" << endl;
            cout << "  Le quedan "
                 << j2->getCantidad() << " carta(s)." << endl;
        } else {
            cout << "  EMPATE â€” Ambos sin cartas." << endl;
        }
        linea('*');
    }
};
