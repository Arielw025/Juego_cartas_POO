#pragma once
#include "Dragon.h"
#include "Zombie.h"
#include "Paladin.h"
#include "Mago.h"
#include <vector>
#include <algorithm>
using namespace std;

// ============================================================
//  CLASE: Mazo
//  30 cartas: 4 Magos, 6 Dragones, 10 Zombies, 10 Paladines
// ============================================================
class Mazo {
private:
    vector<Carta*> cartas;

public:
    Mazo() { construir(); }

    ~Mazo() {
        for (Carta* c : cartas) delete c;
        cartas.clear();
    }

    // Crea las 30 cartas con sus nombres
    void construir() {
        for (Carta* c : cartas) delete c;
        cartas.clear();

        // 4 Magos
        cartas.push_back(new Mago("Merlin"));
        cartas.push_back(new Mago("Gandalf"));
        cartas.push_back(new Mago("Saruman"));
        cartas.push_back(new Mago("Rincewind"));

        // 6 Dragones
        cartas.push_back(new Dragon("Pyros"));
        cartas.push_back(new Dragon("Glacius"));
        cartas.push_back(new Dragon("Terranax"));
        cartas.push_back(new Dragon("Voltaris"));
        cartas.push_back(new Dragon("Shadewing"));
        cartas.push_back(new Dragon("Emberclaw"));

        // 10 Zombies
        cartas.push_back(new Zombie("Rex Podrido"));
        cartas.push_back(new Zombie("Masa Zombi"));
        cartas.push_back(new Zombie("El Infectado"));
        cartas.push_back(new Zombie("Dientes Rotos"));
        cartas.push_back(new Zombie("Arrastra Pies"));
        cartas.push_back(new Zombie("Cerebro Muerto"));
        cartas.push_back(new Zombie("Ojos Blancos"));
        cartas.push_back(new Zombie("Garra Podrida"));
        cartas.push_back(new Zombie("Visceras"));
        cartas.push_back(new Zombie("El Rabiosa"));

        // 10 Paladines
        cartas.push_back(new Paladin("Sir Lancelot"));
        cartas.push_back(new Paladin("Guardian Sagrado"));
        cartas.push_back(new Paladin("Arthas"));
        cartas.push_back(new Paladin("Barristan"));
        cartas.push_back(new Paladin("Leon Divino"));
        cartas.push_back(new Paladin("Cruzado"));
        cartas.push_back(new Paladin("Portador de Luz"));
        cartas.push_back(new Paladin("Escudo Eterno"));
        cartas.push_back(new Paladin("Juicio Final"));
        cartas.push_back(new Paladin("Aura Dorada"));
    }

    // Barajar aleatoriamente
    void barajar() {
        for (int i = (int)cartas.size() - 1; i > 0; i--) {
            int j = rand() % (i + 1);
            swap(cartas[i], cartas[j]);
        }
        cout << "[MAZO] Barajado. Total: " << cartas.size() << " cartas." << endl;
    }

    // Toma la carta del tope y la retorna (la saca del mazo)
    Carta* robar() {
        if (cartas.empty()) return nullptr;
        Carta* c = cartas.back();
        cartas.pop_back();
        return c;
    }

    // Toma una carta aleatoria (para hechizo robo)
    Carta* robarAleatoria() {
        if (cartas.empty()) return nullptr;
        int idx = rand() % cartas.size();
        Carta* c = cartas[idx];
        cartas.erase(cartas.begin() + idx);
        return c;
    }

    int  getTamano()  const { return (int)cartas.size(); }
    bool estaVacio()  const { return cartas.empty(); }

    void mostrar() const {
        cout << "\n  [MAZO - " << cartas.size() << " cartas restantes]" << endl;
        for (int i = 0; i < (int)cartas.size(); i++)
            cout << "    " << i+1 << ". " << cartas[i]->getNombre()
                 << " (" << cartas[i]->getRareza() << ")" << endl;
    }
};
