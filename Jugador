#pragma once
#include "Mago.h"
#include <vector>
#include <string>
using namespace std;


//  CLASE: Jugador
// 
class Jugador {
private:
    string         nombre;
    vector<Carta*> mano;

public:
    Jugador(const string& nom) : nombre(nom) {}
    ~Jugador() {}   // el Juego libera la memoria

    // Recibe carta; si es Mago asigna hechizo alazar
    void recibirCarta(Carta* c) {
        Mago* m = dynamic_cast<Mago*>(c);
        if (m) m->asignarHechizo();
        mano.push_back(c);
    }

    // Verifica y aplica especiales SOLO de las cartas de ESTE jugador
    // Solo se muestran los especiales de este jugador, no del rival
    void verificarEspeciales() {
        int nDrag = 0, nZomb = 0, nPal = 0;
        for (Carta* c : mano) {
            if (c->getNombre() == "Dragon")  nDrag++;
            if (c->getNombre() == "Zombie")  nZomb++;
            if (c->getNombre() == "Paladin") nPal++;
        }

        bool hayAlguno = false;

        for (Carta* c : mano) {
            if (nDrag >= 2 && c->getNombre() == "Dragon"
                && !c->getEspecialAplic()) {
                c->aplicarEspecial(); hayAlguno = true;
            }
            if (nZomb >= 2 && c->getNombre() == "Zombie"
                && !c->getEspecialAplic()) {
                c->aplicarEspecial(); hayAlguno = true;
            }
            if (nPal >= 2 && c->getNombre() == "Paladin"
                && !c->getEspecialAplic()) {
                c->aplicarEspecial(); hayAlguno = true;
            }
        }

        // Mago: mostrar hechizo asignado
        for (Carta* c : mano) {
            Mago* m = dynamic_cast<Mago*>(c);
            if (m) { m->aplicarEspecial(); hayAlguno = true; }
        }

        if (!hayAlguno)
            cout << "    (Sin ataques especiales esta ronda)" << endl;
    }

    // Muestra mano completa con el estilo visual de las cartas
    void mostrarMano() const {
        if (mano.empty()) {
            cout << "    (Sin cartas)" << endl;
            return;
        }
        for (int i = 0; i < (int)mano.size(); i++) {
            cout << "\n  Carta [" << i+1 << "]:" << endl;
            mano[i]->mostrar();
        }
    }

    // Muestra mano en formato resumido (para elegir carta)
    void mostrarManoResumida() const {
        for (int i = 0; i < (int)mano.size(); i++) {
            cout << "    [" << i+1 << "] "
                 << mano[i]->getNombre()
                 << "  VID: " << mano[i]->getVida()
                 << "/" << mano[i]->getVidaBase()
                 << "  ATK: " << mano[i]->getAtaque()
                 << "  DEF: " << mano[i]->getDefensa()
                 << "  [" << mano[i]->getRareza() << "]" << endl;
        }
    }

    // Retorna puntero a carta por indice 0-based (NO la saca de la mano)
    Carta* verCarta(int idx) const {
        if (idx < 0 || idx >= (int)mano.size()) return nullptr;
        return mano[idx];
    }

    // Elimina cartas con vida <= 0. Retorna cuantas se eliminaron.
    int eliminarMuertas() {
        int elim = 0;
        for (int i = (int)mano.size() - 1; i >= 0; i--) {
            if (mano[i]->getVida() <= 0) {
                cout << "    [ELIMINADA] "
                     << mano[i]->getNombre()
                     << " (vida agotada)" << endl;
                delete mano[i];
                mano.erase(mano.begin() + i);
                elim++;
            }
        }
        return elim;
    }

    // Roba una carta ALEATORIA de la mano (hechizo robo del mago)
    Carta* perderCartaAleatoria() {
        if (mano.empty()) return nullptr;
        int idx = rand() % (int)mano.size();
        Carta* c = mano[idx];
        mano.erase(mano.begin() + idx);
        return c;
    }

    string          getNombre()   const { return nombre; }
    int             getCantidad() const { return (int)mano.size(); }
    bool            sinCartas()   const { return mano.empty(); }
    vector<Carta*>& getMano()           { return mano; }
};
